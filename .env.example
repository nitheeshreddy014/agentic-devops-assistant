# =============================================================================
# Agentic DevOps Troubleshooting Assistant - Environment Configuration
# =============================================================================
#
# REQUIRED SECRET
# ---------------
# Get your free Groq API key at: https://console.groq.com
# 1. Sign up / Log in at https://console.groq.com
# 2. Navigate to "API Keys" in the left sidebar
# 3. Click "Create API Key"
# 4. Copy the key and paste it below
# NO credit card required for the free tier.
#
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# MODEL CONFIGURATION (Optional - defaults shown)
# =============================================================================
# Change this to use a different Groq model. Free-tier supported models:
#   llama-3.3-70b-versatile   (default, best quality)
#   llama-3.1-8b-instant      (faster, lower quality)
#   mixtral-8x7b-32768        (good balance)
#   gemma2-9b-it              (Google Gemma via Groq)
#
LLM_MODEL=llama-3.3-70b-versatile

# =============================================================================
# OPTIONAL ALTERNATIVE LLM PROVIDERS
# =============================================================================
# Only GROQ_API_KEY is required. These are optional alternatives.

# Google Gemini (https://aistudio.google.com/app/apikey)
# GOOGLE_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=

# Active provider: groq | gemini | openrouter  (default: groq)
# LLM_PROVIDER=groq

# =============================================================================
# APPLICATION SETTINGS (Optional)
# =============================================================================
# Secret for signing stateless investigation state (auto-generated if empty)
# STATE_SECRET=change-me-to-a-random-32-char-string

# Maximum input sizes (bytes)
# MAX_LOG_SIZE=50000
# MAX_CONFIG_SIZE=30000
# MAX_DESCRIPTION_SIZE=5000

# Log level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# =============================================================================
# LOCAL DEVELOPMENT
# =============================================================================
# Frontend dev server (Next.js)
# NEXT_PUBLIC_API_URL=http://localhost:8000
